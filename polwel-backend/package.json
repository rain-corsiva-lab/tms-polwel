{
  "name": "polwel-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:local": "NODE_ENV=local node dist/index.js",
    "start:staging": "NODE_ENV=staging node dist/index.js",
    "start:production": "NODE_ENV=production node dist/index.js",
    "dev": "nodemon src/index.ts",
    "dev:safe": "bash -c 'kill -9 $(lsof -ti :3001) 2>/dev/null || true' && nodemon src/index.ts",
    "dev:local": "NODE_ENV=local nodemon src/index.ts",
    "dev:staging": "NODE_ENV=staging nodemon src/index.ts",
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts && npm run db:permissions:upsert && npm run db:seed:grant-kukuh",
    "db:seed:grant-kukuh": "ts-node scripts/seedGrantAllPermissionsToJohn.ts",
    "db:permissions:upsert": "ts-node scripts/upsertMissingPermissions.ts",
    "debug:course-run-search": "ts-node scripts/testCourseRunSearch.ts",
    "pm2:restart:staging": "pm2 restart ecosystem.config.js --only polwel-backend-staging --env staging",
    "pm2:restart:local": "pm2 restart ecosystem.config.js --only polwel-backend-local --env local",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "@prisma/client": "^6.19.0",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/puppeteer": "^5.4.7",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.11.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.5",
    "path-to-regexp": "^6.2.1",
    "pdfkit": "^0.17.2",
    "puppeteer": "^24.36.1",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.3",
    "@types/sanitize-html": "^2.16.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
